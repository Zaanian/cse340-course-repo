<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-category/<%= categoryDetails.category_id %>" method="POST">
            <div class="form-group">
                <label for="title">Category Title</label>
                <input type="text" id="title" name="title" value="<%= categoryDetails.title %>" maxlength="150"
                    required />
            </div>

            <button type="submit">Update Category</button>
        </form>
    </main>
    <%- include('partials/footer') %>