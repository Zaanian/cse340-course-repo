<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Name: <%= category.title %>
        </p>
        <ul>
            <% projects.forEach(project=> {%>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong>
                            <%= project.title %>
                        </strong>
                    </a>

                </li>
                <% }); %>
        </ul>
        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/edit-category/<%= category.category_id %>">Edit category</a>
                <% } %>
        </p>
    </main>
    <%- include('partials/footer') %>