<%- include('partials/header') %>
<main>
    <h1>
        <%= title %>
    </h1>

    <%
        // Format projectDetails.date to YYYY-MM-DD for <input type="date">
        let formattedDate = '';
        if (projectDetails && projectDetails.date) {
            if (projectDetails.date instanceof Date && !Number.isNaN(projectDetails.date.getTime())) {
                formattedDate = projectDetails.date.toISOString().slice(0, 10);
            } else {
                const rawDate = String(projectDetails.date);
                formattedDate = rawDate.includes('T') ? rawDate.split('T')[0] : rawDate.slice(0, 10);
            }
        }
    %>

    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <% organizations.forEach((org) => { %>
                    <option
                        value="<%= org.organization_id %>"
                        <%= String(org.organization_id) === String(projectDetails.organization_id) ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="form-group">
            <label for="title">Project Title</label>
            <input type="text" id="title" name="title" value="<%= projectDetails.title %>" maxlength="150"
                required />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" maxlength="500"
                required><%= projectDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= projectDetails.location %>" maxlength="150"
                required />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input type="date" id="date" name="date" value="<%= formattedDate %>" required />
        </div>

        <button type="submit">Update Project</button>
    </form>
</main>
<%- include('partials/footer') %>