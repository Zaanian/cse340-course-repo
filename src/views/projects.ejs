<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>

            <% projects.forEach(project=> {%>
                <li>
                    <%= new Date(project.date).toLocaleDateString() %>:
                        <%= project.title %>
                            <strong>
                                (<%= project.name %>)
                            </strong>
                </li>
                <% }); %>

        </ul>
    </main>
    <%- include('partials/footer') %>