<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= projectDetails.title %>
        </h2>

        <p>Description: <%= projectDetails.description %>
        </p>
        <p>
            <%= new Date(projectDetails.date).toLocaleDateString() %>
        </p>
        <p>
            Location: <%= projectDetails.location %>
        </p>
        <p><a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name%>
            </a>

        </p>
        <div>
            <% categories.forEach(category=> { %>
                <!-- Link tag to the category details page -->
                <a href="/category/<%= category.category_id %>" class="category-tag">
                    <%= category.category_name %>
                </a>
                <% }) %>
        </div>
        <div><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a></div>



    </main>
    <%- include('partials/footer') %>