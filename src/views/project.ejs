<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= projectDetails.title %>
        </h2>

        <p>Description: <%= projectDetails.description %>
        </p>
        <p>
            <%= new Date(projectDetails.date).toLocaleDateString() %>
        </p>
        <p>
            Location: <%= projectDetails.location %>
        </p>
        <p><a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name%>
            </a>

        </p>



    </main>
    <%- include('partials/footer') %>